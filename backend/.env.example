DATABASE_URL=postgresql://lumohub:lumohub123@localhost:5432/lumohub_db
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=https://lumohub.luminostech.tech, https://api.luminostech.tech
APP_ENV=development
APP_VERSION=0.12.0
DEVICE_LOGS_ENABLED=true
TZ=Asia/Ho_Chi_Minh

# LLM API Keys (required for AI features)
GEMINI_API_KEY=your-gemini-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key
GROQ_API_KEY=your-groq-api-key
GOOGLE_API_KEY=your-google-api-key
TAVILY_API_KEY=your-tavily-api-key

LUMO_LOG_PATH=system.log
LUMO_ENABLE_WEB_SEARCH=false

# Fast TTS & Audio Cache (DSOFT-AudioTTS integration)
# TTS_PROVIDER: auto | http | elevenlabs | gemini | google_translate | tone
TTS_PROVIDER=auto
TTS_URL=
TTS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
TTS_VOICE=Kore
TTS_MODEL=eleven_flash_v2_5
TTS_RESPONSE_FORMAT=pcm
TTS_AUTH_HEADER=Authorization
TTS_AUTH_PREFIX=Bearer
TTS_CACHE_DIR=data/tts_cache

# Web Push (generate one persistent P-256 VAPID pair per environment)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@luminostech.tech
